    "vendor/provenance/packages/recorder/src/events/external-change-content.ts",
    "vendor/provenance/packages/recorder/src/events/external-change-detector.ts",
    "vendor/provenance/packages/recorder/src/events/explanation-tags.ts",
    "vendor/provenance/packages/recorder/src/state/expected-content.ts",
